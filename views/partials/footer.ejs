<section class="newsletter-band" aria-labelledby="newsletter-title">
  <div class="container newsletter-band__inner">
    <div>
      <p class="eyebrow eyebrow--light">Un peu d’évasion dans votre boîte mail</p>
      <h2 id="newsletter-title">Les prochaines belles offres ?</h2>
      <p>Recevez nos actualités et idées de voyage.</p>
    </div>
    <form class="newsletter-form js-form" action="/api/newsletter" method="post">
      <label class="sr-only" for="newsletter-email">Votre adresse e-mail</label>
      <input id="newsletter-email" name="email" type="email" autocomplete="email" placeholder="Votre adresse e-mail" required>
      <button class="button button--orange" type="submit">Je m’inscris <span aria-hidden="true">→</span></button>
      <p class="form-feedback" aria-live="polite"></p>
    </form>
  </div>
</section>
