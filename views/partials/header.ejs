<div class="topbar">
  <div class="container topbar__inner">
    <a class="topbar__phone" href="tel:+21655333100" aria-label="Appelez Mercan Voyages au +216 55 333 100">☎ <span>+216 55 333 100</span></a>
    <div class="topbar__links">
      <a class="social-link" href="https://www.facebook.com/mercan.voyage" target="_blank" rel="noopener noreferrer" aria-label="Mercan Voyages sur Facebook">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.1H7.3V13h2.8v8h3.4Z"/></svg>
      </a>
      <% if (user) { %>
        <a href="<%= user.role === 'admin' ? '/admin' : '/mon-compte' %>"><%= user.name %></a>
        <button class="link-button" type="button" data-logout>Se déconnecter</button>
      <% } else { %>
        <a href="/connexion">Se connecter</a>
        <a href="/inscription">S'inscrire</a>
      <% } %>
    </div>
  </div>
</div>
<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="/" aria-label="Mercan Voyages, accueil">
      <img src="/images/mercan.jpg" width="72" height="72" alt="Mercan Voyages">
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation" aria-label="Ouvrir le menu">
      <span></span><span></span><span></span>
    </button>
    <nav class="main-nav" id="main-navigation" aria-label="Navigation principale">
      <a href="/" <%= currentPath === '/' ? 'aria-current="page"' : '' %>>Accueil</a>
      <a href="/hotels" <%= currentPath.startsWith('/hotels') ? 'aria-current="page"' : '' %>>Hôtels</a>
      <div class="nav-dropdown">
        <a href="/vol" class="nav-dropdown__trigger" <%= currentPath === '/vol' ? 'aria-current="page"' : '' %>>Vol <span aria-hidden="true">⌄</span></a>
        <div class="nav-dropdown__menu">
          <a href="/vol?compagnie=nouvelair">Nouvelair</a>
          <a href="/vol">Formulaire de vol</a>
        </div>
      </div>
      <a href="/voyages" <%= currentPath === '/voyages' ? 'aria-current="page"' : '' %>>Voyages</a>
      <a href="/tours" <%= currentPath === '/tours' ? 'aria-current="page"' : '' %>>Tours</a>
      <a href="/omra" <%= currentPath === '/omra' ? 'aria-current="page"' : '' %>>Omra</a>
      <a href="/contact" <%= currentPath === '/contact' ? 'aria-current="page"' : '' %>>Contact</a>
    </nav>
  </div>
</header>
<main id="main-content">
