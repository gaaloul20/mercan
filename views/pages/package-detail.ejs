<%- include('../partials/head', { title, description }) %>
<%- include('../partials/header') %>
<div class="container breadcrumbs"><a href="/">Accueil</a><span aria-hidden="true">/</span><a href="/<%= item.type === 'voyage' ? 'voyages' : item.type === 'tour' ? 'tours' : 'omra' %>"><%= typeLabel %></a><span aria-hidden="true">/</span><span><%= item.title %></span></div>
<section class="section container detail-layout">
  <% const image = asList(item.images)[0] || 'istanbul'; %>
  <div class="detail-main"><div class="package-cover scene scene--<%= isPhoto(image) ? 'photo' : image %>" style="<%= sceneBackground(image) %>"><% if (isPhoto(image)) { %><img class="scene__image" src="<%= image %>" alt="Offre de voyage : <%= item.title %>"><% } else { %><span class="scene__label"><%= item.destination %></span><% } %></div><p class="eyebrow"><%= typeLabel %> · <%= item.duration %></p><h1 class="detail-title"><%= item.title %></h1><p class="detail-lead"><%= item.summary %></p><p><%= item.description %></p>
    <section class="detail-copy"><h2>Dates de départ</h2><ul class="check-list"><% asList(item.dates).forEach((date) => { %><li><%= date %></li><% }) %></ul><h2>Programme indicatif</h2><div class="itinerary"><% asList(item.program).forEach((day) => { %><article class="itinerary__day"><span><%= day.day %></span><div><h3><%= day.title %></h3><p><%= day.text %></p></div></article><% }) %></div><div class="included-grid"><div><h2>Le prix comprend</h2><ul class="check-list"><% asList(item.inclusions).forEach((entry) => { %><li><%= entry %></li><% }) %></ul></div><div><h2>Non inclus</h2><ul class="check-list check-list--muted"><% asList(item.exclusions).forEach((entry) => { %><li><%= entry %></li><% }) %></ul></div></div></section>
  </div>
  <aside class="booking-card"><p class="eyebrow">Votre prochaine escapade</p><h2><%= item.price ? `${Number(item.price).toFixed(0)} TND${item.type === 'omra' ? ' / personne' : ''}` : 'Tarif sur demande' %></h2><p><strong><%= item.duration %></strong><br><%= item.destination %></p><p>Les dates, places disponibles et prestations sont à confirmer avec un conseiller.</p><button class="button button--orange button--wide" type="button" data-request data-request-type="<%= item.type %>" data-item-id="<%= item.id %>" data-item-title="<%= item.title %>">Demander des informations</button><a class="booking-card__phone" href="tel:+21655333100">☎ +216 55 333 100</a></aside>
</section>
<%- include('../partials/footer') %>
