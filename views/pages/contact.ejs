<%- include('../partials/head', { title, description }) %>
<%- include('../partials/header') %>
<section class="page-hero page-hero--contact"><div class="container"><p class="eyebrow eyebrow--light">Parlons de votre prochain voyage</p><h1>Nous contacter</h1><p>Notre équipe à Tunis est là pour vous renseigner et vous accompagner.</p></div></section>
<section class="section container contact-layout">
  <div class="contact-info">
    <p class="eyebrow">À votre écoute, tous les jours</p><h2>Rendez-nous visite ou appelez-nous</h2>
    <div class="contact-info__item"><span aria-hidden="true">☎</span><div><h3>Téléphone & WhatsApp</h3><a href="tel:+21655333100">+216 55 333 100</a></div></div>
    <div class="contact-info__item"><span aria-hidden="true">⌖</span><div><h3>Notre agence</h3><p>Avenue de Madrid, Le Passage<br>Tunis 1001, Tunisie</p><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Avenue%20de%20Madrid%2C%20Le%20Passage%2C%20Tunis%201001" target="_blank" rel="noopener noreferrer">Voir l’itinéraire <span aria-hidden="true">→</span></a></div></div>
    <div class="contact-info__item"><span aria-hidden="true">◷</span><div><h3>Horaires</h3><p>Ouvert tous les jours</p></div></div>
    <div class="map-card"><iframe src="https://www.google.com/maps?q=Avenue%20de%20Madrid%2C%20Le%20Passage%2C%20Tunis%201001&output=embed" title="Localisation de Mercan Voyages, avenue de Madrid, Le Passage, Tunis" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div>
  </div>
  <div class="form-card"><p class="eyebrow">Un message suffit</p><h2>Écrivez-nous</h2>
    <form class="js-form" action="/api/contact" method="post">
      <label class="field"><span>Nom complet</span><input name="name" required minlength="2" maxlength="120" autocomplete="name"></label>
      <label class="field"><span>Adresse e-mail</span><input name="email" type="email" required maxlength="190" autocomplete="email"></label>
      <label class="field"><span>Téléphone (facultatif)</span><input name="phone" type="tel" maxlength="30" pattern="[+()0-9 .-]{7,30}" autocomplete="tel"></label>
      <label class="field"><span>Objet</span><input name="subject" required minlength="2" maxlength="180"></label>
      <label class="field"><span>Votre message</span><textarea name="message" rows="5" required minlength="5" maxlength="3000"></textarea></label>
      <button class="button button--blue" type="submit">Envoyer le message <span aria-hidden="true">→</span></button><p class="form-feedback" aria-live="polite"></p>
    </form>
  </div>
</section>
<%- include('../partials/footer') %>
