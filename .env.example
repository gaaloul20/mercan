PORT=3000
NODE_ENV=development
SESSION_SECRET=remplacer-par-une-longue-cle-aleatoire
# MongoDB Atlas (requis pour le serveur et le seed)
MONGODB_URI=mongodb+srv://<utilisateur>:<mot-de-passe>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=mercan_voyages
